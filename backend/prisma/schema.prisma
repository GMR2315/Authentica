datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  product_id    String   @id @default(cuid())
  name          String
  model         String
  serial_number String   @unique
  description   String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Optional fields for UI (Register Product, Dashboard, Upload Assets, Provenance)
  category               String?   // Dropdown: e.g. Electronics, Apparel
  brand                  String?   // Brand name
  manufacturing_date     DateTime? // Manufacturing date (date picker)
  manufacturing_location String?   // Where product was manufactured
  materials              String?   // e.g. "Gold, Leather, Stainless Steel"
  weight_grams           Int?      // Weight in grams
  dimensions             String?   // e.g. "10 x 5 x 2 cm"
  color                  String?   // Color
  special_features       String?   // Special features text
  retail_price           Decimal?  @db.Decimal(12, 2) // Retail price in dollars
  warranty_period        String?   // e.g. "2 years", "Lifetime"
  tags                   String?   // Comma-separated tags for search/filtering
  sku                    String?   // Product SKU (non-unique)
  quantity               Int?      // Product quantity
  batch_id               String?   // e.g. "BATCH-001"
  quality_score          Float?    // e.g. 98.5
  image_cids             String[]  @default([]) // IPFS CIDs or URLs for product images
  document_cids          String[]  @default([]) // IPFS CIDs or URLs for documents

  // Relations
  nft_passport NFTPassport?
  tag          Tag?
  provenance   ProvenanceEvent[]
}

model NFTPassport {
  nft_passport_id  String   @id @default(cuid())
  product_id       String   @unique
  token_id         BigInt   @unique
  contract_address String
  metadata_hash    String
  metadata_cid     String
  mint_tx_hash     String
  minted_at        DateTime @default(now())

  // Relations
  product Product @relation(fields: [product_id], references: [product_id])
  tag     Tag?
}

model Tag {
  tag_pk          String   @id @default(cuid())
  tag_id          String   @unique
  product_id      String   @unique
  nft_passport_id String   @unique
  tag_type        TagType
  issued_at       DateTime @default(now())

  // Relations
  product      Product     @relation(fields: [product_id], references: [product_id])
  nft_passport NFTPassport @relation(fields: [nft_passport_id], references: [nft_passport_id])
}

model ProvenanceEvent {
  event_id          String   @id @default(cuid())
  product_id        String
  event_type        String
  event_description String?
  event_time        DateTime
  created_at        DateTime @default(now())

  // Relations
  product Product @relation(fields: [product_id], references: [product_id])
}

model VerificationLog {
  verification_id String             @id @default(cuid())
  tag_id          String
  status          VerificationStatus
  scanned_at      DateTime           @default(now())
}

enum TagType {
  QR
  NFC
  RFID
  PUF
}

enum VerificationStatus {
  AUTHENTIC
  TAMPERED
  FAKE
}

model Admin {
  admin_id   String   @id @default(cuid())
  username   String   @unique
  password   String
  created_at DateTime @default(now())
}
